{
  "schemaVersion": 1,
  "id": "seqbro2-puffin",
  "name": "Puffin",
  "description": "Puffin FANTOM CAGE sequence model exported to ONNX.",
  "assemblyId": "hg38",
  "sequenceProvider": {
    "type": "ucsc",
    "genome": "hg38"
  },
  "model": {
    "format": "onnx",
    "url": "/computational/models/seqbro2-puffin.onnx",
    "inputName": "input1"
  },
  "inference": {
    "flankBp": 325,
    "maxWindowBp": 86000,
    "maxResolutionBp": 24
  },
  "plotGroups": [
    {
      "id": "prediction",
      "label": "Prediction",
      "subtrackIds": ["puffin-pred-plus", "puffin-pred-minus"],
      "dashedSubtrackIds": ["puffin-pred-minus"],
      "height": 96
    },
    {
      "id": "motif-activations",
      "label": "Motif activations",
      "groupIds": ["motif-activations"],
      "height": 116
    },
    {
      "id": "motif-effects",
      "label": "Motif effects",
      "groupIds": ["motif-effects", "opposite-motif-effects"],
      "dashedGroupIds": ["opposite-motif-effects"],
      "height": 124
    },
    {
      "id": "effect-components",
      "label": "Effect decomposition",
      "groupIds": ["effect-components"],
      "dashedSubtrackIds": [
        "puffin-effect-motif-rev",
        "puffin-effect-initiator-rev",
        "puffin-effect-trinucleotide-rev",
        "puffin-effect-total-rev"
      ],
      "height": 108
    }
  ],
  "subtracks": [
    {
      "id": "puffin-pred-plus",
      "name": "Prediction (+ strand)",
      "kind": "signal",
      "color": "#172554",
      "height": 76,
      "outputName": "y_pred",
      "channelIndex": 0,
      "groupId": "overview",
      "groupLabel": "Overview",
      "defaultVisible": true,
      "role": "prediction",
      "scaleMode": "positive"
    },
    {
      "id": "puffin-pred-minus",
      "name": "Prediction (− strand)",
      "kind": "signal",
      "color": "#52678E",
      "height": 76,
      "outputName": "y_pred_rev",
      "channelIndex": 0,
      "groupId": "overview",
      "groupLabel": "Overview",
      "defaultVisible": true,
      "role": "prediction",
      "scaleMode": "signed"
    },
    {
      "id": "puffin-effects-total",
      "name": "Total sequence effect",
      "kind": "signal",
      "color": "#2CA02C",
      "height": 76,
      "outputName": "effects_total",
      "channelIndex": 0,
      "groupId": "overview",
      "groupLabel": "Overview",
      "defaultVisible": true,
      "role": "effect",
      "scaleMode": "signed"
    },
    {
